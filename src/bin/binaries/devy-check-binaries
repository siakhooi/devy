#!/usr/bin/env bash

set -uo pipefail

usage() {
  echo "Usage: $(basename "$0") [-h] [-V] [-f binary-list-file] binary..."
  echo "  -h                      Show this help message and exit"
  echo "  -V                      show binary version whenever possible"
  echo "  -f binary-list-file     Specify a file containing a list of binaries to check (one per line)"
  echo "  binary...               List of binaries to check"
}
binaries=()
show_version=false
while getopts "hVf:" arg; do
  case $arg in
    h)
      usage
      exit 0
      ;;
    f)
      if [[ ! -f $OPTARG ]]; then
        echo.error "File not found: $OPTARG"
        exit 1
      fi
      mapfile -t temp_array < <(grep -v '^[[:space:]]*$' "$OPTARG")
      binaries+=("${temp_array[@]}")
      ;;
    V)
      show_version=true
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))
binaries+=("$@")

if [[ ${#binaries[@]} -eq 0 ]]; then
  usage
  exit 1
fi

get_version() {
  local bin=$1
  case $bin in
    jq) "$bin" --version | cut -d'-' -f2 ;;
    yq) "$bin" --version | grep -oP 'v\K[0-9]+\.[0-9]+\.[0-9]+' ;;
    npm|yarn|firebase) "$bin" --version ;;
    groovy) "$bin" --version | awk '/Groovy Version:/ {print $3}' ;;
    git|podman) "$bin" --version | cut -d' ' -f3 ;;
    python) "$bin" --version | awk '{print $2}' ;;
    gh) "$bin" --version | awk 'NR==1 {print $3}' ;;
    glab) "$bin" version | awk 'NR==1 {print $2}' ;;
    node) "$bin" --version | cut -c2- ;;
    spring) "$bin" --version | cut -d'v' -f2 ;;
    go) "$bin" version | grep -oP 'go\K[0-9]+\.[0-9]+\.[0-9]+' ;;
    docker) "$bin" --version | grep -oP '[0-9]+\.[0-9]+\.[0-9]+' ;;
    robot) "$bin" --version | awk '{print $3}' ;;
    java) "$bin" -version 2>&1 | awk -F'"' '/version/ {print $2}' ;;
    helm) "$bin" version | grep -oP 'Version:"v\K[0-9]+\.[0-9]+\.[0-9]+' ;;
    mvn) "$bin" --version | grep -oP 'Apache Maven \K[^ ]+' ;;
    gradle) "$bin" -v | awk '/^Gradle/ {print $2}' ;;
    *) echo "" ;;
  esac
}

found=()
not_found=()

# sort and remove duplicates
mapfile -t binaries < <(printf '%s\n' "${binaries[@]}" | sort -u)

for bin in "${binaries[@]}"; do
  if command -v "$bin" >/dev/null 2>&1; then
    if $show_version; then
      version=$(get_version "$bin")
      if [[ -n $version ]]; then
        found+=("$bin=$version")
      else
        found+=("$bin")
      fi
    else
      found+=("$bin")
    fi
  else
    not_found+=("$bin")
  fi
done

# sort
mapfile -t found < <(printf "%s\n" "${found[@]}" | sort)
mapfile -t not_found < <(printf "%s\n" "${not_found[@]}" | sort)

[[ ${#found[@]} -gt 0 ]] && echo.green -n "${found[@]}"
[[ ${#found[@]} -gt 0 && ${#not_found[@]} -gt 0 ]] && echo -n ' '
[[ ${#not_found[@]} -gt 0 ]] && echo.red "${not_found[@]}"

exit $((${#not_found[@]} > 0))
