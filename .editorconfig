# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[src/bin/**]
indent_style = space
indent_size = 2
switch_case_indent = true

[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true

[[shell]]
indent_style = space
indent_size = 2
switch_case_indent = true

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
